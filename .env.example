# Connect4-Battle Environment Configuration
# Copy this file to .env and customize values as needed

# Docker image for Linera development environment
LINERA_IMAGE=kvozt/linera-dev:latest

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# Linera network configuration
PRNG_SEED=37
INITIAL_CHAINS=3
FAUCET_PORT=8080
NETWORK_READY_TIMEOUT=180

# Bankroll configuration
BONUS_AMOUNT=25000

# Service ports (GraphQL endpoints)
SERVICE_PORT_A=8081
SERVICE_PORT_B=8082
LOBBY_SERVICE_PORT=8083

# Frontend ports (HTTP servers)
FRONTEND_PORT_A=5173
FRONTEND_PORT_B=5174

# Production overrides (uncomment for deployment)
# NODE_SERVICE_URL=https://conway1.linera.blockhunters.services
# CONNECT4_APP_ID=75b64789de1b3ec591c67431a244bd99e602a0ac3ae08e868de34dfc199db77d
# BANKROLL_APP_ID=2e4b3859291c03d7949935f007acd500f974138c2ce093127998d66311d0a526
# MASTER_CHAIN=b84bf12c11eca32b88cfdc68faab9a2445ecba61c83d9f36b6eeea02eca76c5d
